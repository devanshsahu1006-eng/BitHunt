# =========================================================================
# BitHunt - Frontend Environment Variables (Vite / Vercel)
# =========================================================================

# Backend API Base URL
#
# - Local Development:
#   Leave blank (or unset) to automatically use the Vite dev-server proxy to http://localhost:5000:
#   VITE_API_BASE_URL=
#
# - Production Deployment on Vercel:
#   Set this in your Vercel Project Settings -> Environment Variables to your production backend URL:
#   VITE_API_BASE_URL=https://your-backend.onrender.com
#
VITE_API_BASE_URL=

# Audio effects toggle (default: true)
VITE_ENABLE_AUDIO=true

# Custom Doctor Doom cursor toggle (default: true)
VITE_ENABLE_CUSTOM_CURSOR=true
