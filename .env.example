# =========================================================================
# BitHunt - Environment Configuration
# =========================================================================

# Flask Backend API URL (Leave blank to use built-in offline mock data)
# When Flask backend is running, set this to your server address, e.g.:
# VITE_API_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=

# Feature Toggles
VITE_ENABLE_AUDIO=true
VITE_ENABLE_CUSTOM_CURSOR=true
