# =========================================================================
# BitHunt - Backend Environment Variables
# (Do NOT place real secrets in this file. Copy to .env for local/server use)
# =========================================================================

# Secret key for signing Flask-Login session cookies
SECRET_KEY=

# Developer admin authentication PIN
DEV_PIN=

# Comma-separated list of developer admin emails
DEVELOPER_EMAILS=

# Round duration in seconds (defaults to 1800 if empty)
ROUND_DURATION_SECONDS=1800

# Production Database URI (optional - defaults to local SQLite if unset)
# e.g. postgresql://user:password@host:port/dbname
DATABASE_URL=

# Frontend production origin for CORS and cookie handling
# e.g. https://your-bithunt-app.vercel.app
FRONTEND_URL=

# Set to "production" in production environments
FLASK_ENV=production
